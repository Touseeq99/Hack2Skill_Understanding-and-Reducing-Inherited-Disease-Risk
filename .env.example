# Environment configuration for Inherited Disease Risk Platform
# Future Health Digital Innovation Challenge 2026 - Fertility Challenge 03

# Application & API
APP_ENV=development
API_PORT=8000
FRONTEND_PORT=3000
PORTAL_PORT=3001

# Database (PostgreSQL with Row-Level Security)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret_local
POSTGRES_DB=inheritance_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secret_local@postgres:5432/inheritance_platform

# Encryption (Application-level AES-256-GCM, per-record keys)
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MASTER_ENCRYPTION_KEY=dGhpc19pc19hXzMyX2J5dGVfc2VjcmV0X2tleV9mb3JfZGVtb18=

# Clinical & Panel Configuration
DEFAULT_RULE_VERSION=v1
PANEL_SENSITIVITY=0.95
CLINICAL_SIGNOFF_STATUS=DRAFT - requires clinical sign-off

# LLM & Adaptation Mode: "template_only" (default), "ollama", or "gemini"
LLM_MODE=template_only
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
GEMINI_API_KEY=

# Auth Secret for JWT / Mock Auth
AUTH_SECRET=demo_insecure_jwt_secret_change_in_production

